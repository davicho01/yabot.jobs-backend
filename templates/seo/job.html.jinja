<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ meta_description }}" />
  <link rel="canonical" href="{{ page_url }}" />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Yabot Jobs" />
  <meta property="og:title" content="{{ job.title }} at {{ job.company_display }}" />
  <meta property="og:description" content="{{ meta_description }}" />
  <meta property="og:url" content="{{ page_url }}" />
  <meta property="og:image" content="{{ base_url }}/og-image.png" />
  {% include "_fonts.html.jinja" %}
  {% include "_icons.html.jinja" %}
  {% include "_base_style.html.jinja" %}
  {% include "_job_style.html.jinja" %}
  {% with page_type = "job" %}{% include "_analytics.html.jinja" %}{% endwith %}
  <script type="application/ld+json">{{ job_ld_json|safe }}</script>
</head>
<body>
  {% include "_header.html.jinja" %}
  <main id="main">
  <div class="wrap wrap--job">
    {% include "_breadcrumb.html.jinja" %}
    {#- Desktop: the card, with a column on the right of where to go next —
        browse more jobs, more at the company, similar jobs — so it isn't
        missed below a long description; phones: the same, after the card. -#}
    <div class="job-layout">
    {# The shared job page's card (the app's /jobs/:id): the plum band with
       the logo tile, then the posting on a white card. #}
    <article class="job-card">
      <div class="job-card__band">
        <span class="job-card__tile">{% if job.company_logo_url %}<img src="{{ job.company_logo_url }}" alt="{{ job.company_display }} logo" width="40" height="40" />{% endif %}</span>
        {# Closed, top right, as on the app's job page. A page rendered once
           can't tell how new an open job still is, so no Found badge. #}
        {% if job.closed_at %}<span class="job-card__status"><i aria-hidden="true"></i>Closed {{ closed_short }}</span>{% endif %}
      </div>
      <div class="job-card__body">
        {# Share and Apply, just under the band on the right, as on the app's
           job page. Share hands out the app's page for the job. Applying
           takes signing in (the employer's link is only for someone signed
           in), so Apply goes to log in and on to that page; someone already
           signed in passes straight through. A closed job has nothing to
           apply to. #}
        <div class="job-actions">
        <button type="button" class="job-share" data-share-url="{{ base_url }}/jobs/{{ job.url_id }}" data-share-title="{{ job.title }} at {{ job.company_display }}" data-share-id="{{ job.url_id }}" data-track="share" aria-label="Share this job" title="Share">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true"><path d="M7.1 9 12.9 5.9M7.1 11l5.8 3.1" stroke="currentColor" stroke-width="1.7" /><circle cx="5" cy="10" r="2.4" stroke="currentColor" stroke-width="1.7" /><circle cx="15" cy="4.8" r="2.4" stroke="currentColor" stroke-width="1.7" /><circle cx="15" cy="15.2" r="2.4" stroke="currentColor" stroke-width="1.7" /></svg>
          <span class="job-share__copied" hidden>Link copied</span>
        </button>
        {% if not job.closed_at %}<a class="job-apply" href="{{ base_url }}/login?next=/jobs/{{ job.url_id }}" data-track="job_apply">Log in to apply</a>{% endif %}
        </div>
        <p class="company-line">{{ job.company_display }}</p>
        <h1>{{ job.title }}</h1>
        {% if job.location %}<p class="meta-line">{{ job.location }}</p>{% endif %}
        {# The facts as the app's chips (pay in lime), then the dates side by
           side in one panel. Company and location are already in the head. #}
        {% set dates = ["Posted", "First found"] %}
        <section class="job-glance" aria-labelledby="glance-h">
          <h2 id="glance-h" class="sr">Job at a glance</h2>
          <dl class="job-facts">
            {% for label, value in glance if label not in dates and label not in ["Company", "Location"] %}<div{% if label == "Pay" %} class="job-facts__pay"{% endif %}><dt class="sr">{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}
          </dl>
          <dl class="job-dates">
            {% for label, value in glance if label in dates %}<div{% if value == "Not listed" %} class="job-dates__missing"{% endif %}><dt>{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}
          </dl>
        </section>
        <div class="job-cta{% if not job.closed_at %} job-fit{% endif %}">
          {# A closed job keeps its page, but there's nothing left to apply to. #}
          {% if job.closed_at %}
          <div class="job-cta__text">
            <strong>This job closed {{ closed_date }}</strong>
            <span>The employer is no longer taking applications.</span>
          </div>
          <div class="job-cta__buttons">
            <a class="btn btn--sunset" href="{{ similar_jobs_url }}" data-track="similar_jobs">Find similar open jobs →</a>
          </div>
          {% else %}
          {# The job board's fit card, as a signed-out visitor sees it: the
             "?" on the rainbow ring, and Check my fit (to sign in). #}
          <span class="job-fit__dial" aria-hidden="true">?</span>
          <div class="job-cta__text job-fit__text">
            <h2>What's your fit?</h2>
            <p>Score your resume against this job to see your fit, the gaps and the risks.</p>
          </div>
          <div class="job-cta__buttons">
            <a class="btn btn--sunset" href="{{ base_url }}/jobs/{{ job.url_id }}/apply" data-track="apply">Check my fit →</a>
          </div>
          {% endif %}
        </div>

        <section class="job-desc" aria-labelledby="about-h">
          <h2 id="about-h">About the job</h2>
          {% if description_html %}{{ description_html|safe }}{% else %}<p>No description is available for this posting yet.</p>{% endif %}
        </section>
      </div>
    </article>

    <aside class="job-side" aria-label="More jobs">
    {% if links.collections or links.location_hubs or sector_link %}
    <nav class="job-more" aria-labelledby="more-h">
      <h2 id="more-h">Browse more jobs</h2>
      <ul>
        {% for label, path in links.collections %}<li><a href="{{ base_url }}/{{ path }}" data-track="collection_link">{{ label }}</a></li>{% endfor %}
        {% for label, path in links.location_hubs %}<li><a href="{{ base_url }}/{{ path }}" data-track="location_hub">{{ label }}</a></li>{% endfor %}
        {% if sector_link %}<li><a href="{{ base_url }}/jobs/{{ country_slug }}/{{ sector_link[0] }}" data-track="sector">{{ sector_link[1] }} jobs in {{ country_name }}</a></li>{% endif %}
      </ul>
    </nav>
    {% endif %}

    {% if links.same_company %}
    <section class="job-related" aria-labelledby="company-h">
      <h2 id="company-h">More jobs at {{ job.company_display }}</h2>
      {% with jobs=links.same_company, track="company_job", one_company=true %}{% include "_job_rows.html.jinja" %}{% endwith %}
      {% if links.company_hub %}<p class="more-link"><a href="{{ base_url }}/{{ links.company_hub }}" data-track="company_hub">All jobs at {{ job.company_display }} &rarr;</a></p>{% endif %}
    </section>
    {% endif %}

    {% if links.similar %}
    <section class="job-related" aria-labelledby="similar-h">
      <h2 id="similar-h">Similar jobs</h2>
      {% with jobs=links.similar, track="similar_job" %}{% include "_job_rows.html.jinja" %}{% endwith %}
    </section>
    {% endif %}
    </aside>
    </div>
  </div>
  </main>
  {% include "_footer.html.jinja" %}
  <script>
    // Share: the phone's share sheet where there is one, or else the link
    // copied. The tap is counted like any button (data-track, in
    // _analytics' script); a share that goes through, as GA4's share event.
    (function () {
      var button = document.querySelector(".job-share");
      if (!button) return;
      var copied = button.querySelector(".job-share__copied");
      var timer = 0;
      function track(method) {
        if (window.gtag) window.gtag("event", "share", { method: method, content_type: "job", item_id: button.dataset.shareId });
      }
      button.addEventListener("click", function () {
        var url = button.dataset.shareUrl;
        if (navigator.share) {
          navigator.share({ title: button.dataset.shareTitle, url: url }).then(function () { track("share_sheet"); }, function () {});
          return;
        }
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(url).then(function () {
          track("copy_link");
          copied.hidden = false;
          clearTimeout(timer);
          timer = setTimeout(function () { copied.hidden = true; }, 2000);
        }, function () {});
      });
    })();
  </script>
</body>
</html>
