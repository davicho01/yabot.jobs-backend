<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ meta_description }}" />
  <link rel="canonical" href="{{ page_url }}" />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Yabot Jobs" />
  <meta property="og:title" content="{{ job.title }} at {{ job.company_display }}" />
  <meta property="og:description" content="{{ meta_description }}" />
  <meta property="og:url" content="{{ page_url }}" />
  <meta property="og:image" content="{{ base_url }}/og-image.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet" />
  {% include "_base_style.html.jinja" %}
  {% include "_job_style.html.jinja" %}
  {% with page_type = "job" %}{% include "_analytics.html.jinja" %}{% endwith %}
  <script type="application/ld+json">{{ job_ld_json|safe }}</script>
</head>
<body>
  {% include "_header.html.jinja" %}
  <main id="main">
  <div class="wrap">
    {% include "_breadcrumb.html.jinja" %}
    {% if job.company_logo_url %}<img class="company-logo" src="{{ job.company_logo_url }}" alt="{{ job.company_display }} logo" width="56" height="56" />{% endif %}
    <h1>{{ job.title }}</h1>
    <p class="meta-line">{{ job.company_display }}{% if job.location %} &middot; {{ job.location }}{% endif %}</p>
    <p class="job-lead">{{ lead }}</p>
    <div class="job-cta">
      <a class="btn btn--accent" href="{{ base_url }}/jobs/{{ job.url_id }}" data-track="apply">Apply on Yabot Jobs</a>
      <a class="btn btn--line" href="{{ base_url }}/jobs/{{ job.url_id }}" data-track="save">Save this job</a>
      <span>Sign in free to get the application link, save the job, or tailor your resume to it.</span>
    </div>

    <section class="job-glance" aria-labelledby="glance-h">
      <h2 id="glance-h">Job at a glance</h2>
      <dl>
        {% for label, value in glance %}<div><dt>{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}
      </dl>
    </section>

    <section class="job-desc" aria-labelledby="about-h">
      <h2 id="about-h">About the job</h2>
      {% if description_html %}{{ description_html|safe }}{% else %}<p>No description is available for this posting yet.</p>{% endif %}
    </section>

    {% if links.same_company %}
    <section class="job-related" aria-labelledby="company-h">
      <h2 id="company-h">More jobs at {{ job.company_display }}</h2>
      {% with jobs=links.same_company, track="company_job" %}{% include "_job_links.html.jinja" %}{% endwith %}
      {% if links.company_hub %}<p class="sector-link-back"><a href="{{ base_url }}/{{ links.company_hub }}" data-track="company_hub">All jobs at {{ job.company_display }} &rarr;</a></p>{% endif %}
    </section>
    {% endif %}

    {% if links.similar %}
    <section class="job-related" aria-labelledby="similar-h">
      <h2 id="similar-h">Similar jobs</h2>
      {% with jobs=links.similar, track="similar_job" %}{% include "_job_links.html.jinja" %}{% endwith %}
    </section>
    {% endif %}

    {% if links.location_hubs or sector_link %}
    <nav class="job-more" aria-label="More jobs">
      <h2>Browse more jobs</h2>
      <ul>
        {% for label, path in links.location_hubs %}<li><a href="{{ base_url }}/{{ path }}" data-track="location_hub">{{ label }}</a></li>{% endfor %}
        {% if sector_link %}<li><a href="{{ base_url }}/jobs/{{ country_slug }}/{{ sector_link[0] }}" data-track="sector">{{ sector_link[1] }} jobs in {{ country_name }}</a></li>{% endif %}
      </ul>
    </nav>
    {% endif %}
  </div>
  </main>
  {% include "_footer.html.jinja" %}
</body>
</html>
