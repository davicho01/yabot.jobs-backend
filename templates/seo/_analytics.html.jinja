  {#- Google Analytics 4: everything (consent defaults, settings, click
      tracking) lives in one shared script, published by
      generate_static_job_pages.py every run (static_pages.publish_assets), so
      changing it never means re-rendering the pages. Each page only says what
      kind of page it is. -#}
  <script src="{{ base_url }}/{{ analytics_script_key }}" async data-page-type="{{ page_type | default('other') }}"></script>
