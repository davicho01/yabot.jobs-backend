<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {#- What a /job/{url_id} page becomes once its job stops qualifying (closed,
      flagged, a duplicate, too old, deleted) — see static_job_pages. noindex
      takes it out of search; Google for Jobs requires expired postings to
      be removed. -#}
  <title>{% if job %}{{ job.title }} at {{ job.company_display }} – {% endif %}No Longer Available | Yabot Jobs</title>
  <meta name="robots" content="noindex, follow" />
  {% include "_fonts.html.jinja" %}
  {% include "_base_style.html.jinja" %}
  {% with page_type = "job_gone" %}{% include "_analytics.html.jinja" %}{% endwith %}
</head>
<body>
  {% include "_header.html.jinja" %}
  <main id="main">
  <div class="wrap wrap--narrow wrap--gone">
    <h1>This job is no longer available</h1>
    {% if job %}
    <p class="meta-line">{{ job.title }} at {{ job.company_display }}{% if job.location %} &middot; {{ job.location }}{% endif %}</p>
    {% endif %}
    <p class="lede">The posting has closed or been removed from the employer's site.</p>
    <div class="head-actions">
      {% if sector_link %}
      <a class="btn btn--chip" href="{{ base_url }}/jobs/{{ country_slug }}/{{ sector_link[0] }}" data-track="sector">Browse current {{ sector_link[1] }} jobs in {{ country_name }}</a>
      {% endif %}
      <a class="btn btn--run" href="{{ base_url }}/jobs" data-track="search">Search all jobs</a>
    </div>
  </div>
  </main>
  {% include "_footer.html.jinja" %}
</body>
</html>
