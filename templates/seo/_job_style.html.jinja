{# Extra styles for the per-job and hub pages, on top of _base_style. #}
<style>
  .company-line { display: flex; align-items: center; gap: 0.6rem; margin: 0 0 0.6rem; font-size: 1.05rem; font-weight: 600; }
  .company-logo { flex: none; width: 40px; height: 40px; object-fit: contain; border-radius: 10px; background: #fff; border: 1px solid var(--line); }
  .job-lead { font-size: 1.05rem; margin: 0 0 1rem; }
  .job-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; padding: 0.5rem 0 1.5rem; border-bottom: 1px solid var(--line); }
  .job-cta span { color: var(--ink-soft); font-size: 0.9rem; flex-basis: 100%; }
  section h2, nav.job-more h2 { font-size: 1.3rem; margin: 2rem 0 0.75rem; }
  .job-glance dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.75rem 1.5rem; margin: 0; }
  .job-glance dt { color: var(--ink-soft); font-size: 0.85rem; }
  .job-glance dd { margin: 0.1rem 0 0; font-weight: 600; overflow-wrap: anywhere; }
  .job-desc { overflow-wrap: anywhere; }
  .job-desc h3 { font-size: 1.08rem; margin: 1.5rem 0 0.4rem; }
  .job-desc a { color: var(--accent); }
  nav.job-more ul, ul.link-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .hub-intro { color: var(--ink-soft); margin: 0 0 1.25rem; }
  .section-more { margin: 0.75rem 0 0; font-size: 0.95rem; }
</style>
