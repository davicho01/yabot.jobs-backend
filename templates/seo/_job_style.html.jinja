{# Extra styles for the per-job pages, on top of _base_style: the app's shared
   job page card (src/pages/JobBoardCards.css, .board--standalone). #}
<style>
  .job-card { border-radius: 32px; background: var(--surface); box-shadow: var(--shadow-card); overflow: hidden; }
  .job-card__band { position: relative; height: 96px; background: var(--plum-band); }
  .job-card__tile { position: absolute; left: 2.25rem; bottom: -32px; width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; background: #fff; box-shadow: 0 6px 18px rgba(31, 26, 53, 0.18); }
  .job-card__tile img { width: 40px; height: 40px; object-fit: contain; border-radius: 8px; }
  .job-card__body { position: relative; padding: 3rem 2.25rem 2.25rem; }
  .company-line { margin: 0 0 0.35rem; font-size: 1rem; font-weight: 600; }
  .job-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.25rem; border-radius: 24px; background: linear-gradient(110deg, color-mix(in srgb, #ec008c 9%, var(--chip)), color-mix(in srgb, #fc8b67 12%, var(--chip))); }
  .job-cta__text { display: flex; flex-direction: column; gap: 0.15rem; flex: 1 1 16rem; }
  .job-cta__text span { font-size: 0.88rem; color: var(--ink-soft); }
  .job-cta__buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  /* The job board's fit card (JobBoardCards.css .case-file__fit): sunset
     washes in two corners, the "?" on a rainbow ring, the gradient button. */
  .job-fit { flex-wrap: nowrap; gap: 1.1rem; background: radial-gradient(60% 120% at 0% 0%, rgba(236, 0, 140, 0.12), transparent 70%), radial-gradient(60% 120% at 100% 100%, rgba(252, 139, 103, 0.16), transparent 70%), var(--chip); }
  .job-fit__dial { flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; font-size: 1.45rem; font-weight: 600; background: radial-gradient(closest-side, var(--surface) 76%, transparent 78%), conic-gradient(#ffd46d, #fc8b67, #ec008c, #7b61ff, #364ea9, #ffd46d); }
  .job-fit__text { flex: 1 1 0; min-width: 0; gap: 0; }
  .job-fit__text h2 { margin: 0; font-size: 1.15rem; font-weight: 600; letter-spacing: -0.02em; }
  .job-fit__text p { margin: 0.2rem 0 0; font-size: 0.88rem; color: var(--ink-soft); }
  .job-fit .btn { padding: 0.75rem 1.2rem; font-size: 0.92rem; font-weight: 600; }
  .job-facts { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.5rem 0 0; }
  /* One height for every pill, the pay pill's bigger type included (as on the job board). */
  .job-facts dd { box-sizing: border-box; display: inline-flex; align-items: center; height: 1.8rem; margin: 0; padding: 0 0.75rem; line-height: 1.2; border-radius: 999px; background: var(--chip); font-size: 0.82rem; font-weight: 600; }
  .job-facts__pay dd { color: var(--pay-ink); background: color-mix(in srgb, var(--lime) 45%, transparent); font-weight: 500; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .job-dates { display: flex; flex-wrap: wrap; margin: 1rem 0 1.25rem; padding: 0.8rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .job-dates > div { flex: 1 1 0; min-width: 8rem; padding: 0 1rem; }
  .job-dates > div:first-child { padding-left: 0; }
  .job-dates > div + div { border-left: 1px solid var(--line); }
  .job-dates dt { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-soft); }
  .job-dates dd { margin: 0.2rem 0 0; font-size: 0.95rem; font-weight: 700; }
  /* "Not listed": no date from the employer, in the labels' grey. */
  .job-dates__missing dd { font-weight: 500; color: var(--ink-soft); }
  /* Closed, in the band's top right: the app's red pill (board__detail-age--closed). */
  .job-card__status { position: absolute; top: 50%; right: 1.5rem; transform: translateY(-50%); display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; line-height: 1.2; white-space: nowrap; color: #fff; background: #d70015; box-shadow: 0 6px 16px -8px rgba(215, 0, 21, 0.7); }
  .job-card__status i { width: 6px; height: 6px; border-radius: 50%; background: #fff; }
  @media (prefers-color-scheme: dark) { .job-facts__pay dd { background: color-mix(in srgb, var(--lime) 16%, transparent); } }
  .job-desc { overflow-wrap: anywhere; }
  .job-desc h3 { font-size: 1.08rem; margin: 1.5rem 0 0.4rem; }
  .job-desc a { color: var(--focus); }
  @media (max-width: 760px) {
    .job-card { border-radius: 26px; }
    .job-card__band { height: 80px; }
    .job-card__tile { left: 1.1rem; }
    .job-card__body { padding: 2.75rem 1.1rem 1.5rem; }
    .job-fit { flex-wrap: wrap; }
    .job-cta__buttons { width: 100%; }
    .job-cta__buttons .btn { flex: 1 1 auto; }
  }
</style>
