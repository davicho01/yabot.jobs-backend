<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Jobs in {{ country_name }}, by Sector | Yabot Jobs</title>
  <meta name="description" content="Browse jobs in {{ country_name }} on Yabot Jobs, by sector — Engineering, Sales, Healthcare, and more. Free to search and apply." />
  <link rel="canonical" href="{{ base_url }}/jobs/{{ country_slug }}" />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Yabot Jobs" />
  <meta property="og:title" content="Jobs in {{ country_name }}, by Sector" />
  <meta property="og:description" content="Browse jobs in {{ country_name }} on Yabot Jobs, by sector." />
  <meta property="og:url" content="{{ base_url }}/jobs/{{ country_slug }}" />
  {% include "_fonts.html.jinja" %}
  {% include "_base_style.html.jinja" %}
  {% with page_type = "country_index" %}{% include "_analytics.html.jinja" %}{% endwith %}
</head>
<body>
  {% include "_header.html.jinja" %}
  <main id="main">
  <div class="wrap wrap--narrow">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ base_url }}/">Home</a> &rsaquo;
      <a href="{{ base_url }}/jobs">Jobs</a> &rsaquo;
      <span aria-current="page">{{ country_name }}</span>
    </nav>
    <h1>Jobs in {{ country_name }}, by Sector</h1>
    {% include "_scan_notice.html.jinja" %}

    {# Each list as the sector page's day rows: a name, a bar sized against
       the list's largest count, and the count. #}
    {% macro rows(items) %}
    {% set top = items | map(attribute=2) | max %}
    <ul class="day-rows day-rows--named">
      {% for name, href, count in items %}
      <li><a href="{{ href }}"><strong>{{ name }}</strong><span class="day-rows__bar"><i style="width: {{ (100 * count / (top or 1)) | round(1) }}%"></i></span><span class="count">{{ "{:,}".format(count) }} job{{ '' if count == 1 else 's' }}</span></a></li>
      {% endfor %}
    </ul>
    {% endmacro %}

    <h2>Sectors</h2>
    {% set sectors = [] %}
    {% for slug, sector_name, count in sector_totals %}{% set _ = sectors.append((sector_name, base_url ~ "/jobs/" ~ country_slug ~ "/" ~ slug, count)) %}{% endfor %}
    {{ rows(sectors) }}

    {% if hub_links.locations %}
    <h2>Top locations</h2>
    {% set places = [] %}
    {% for name, path, count in hub_links.locations %}{% set _ = places.append((name, base_url ~ "/" ~ path, count)) %}{% endfor %}
    {{ rows(places) }}
    {% endif %}
    {% if hub_links.companies %}
    <h2>Top companies hiring</h2>
    {% set companies = [] %}
    {% for name, path, count in hub_links.companies %}{% set _ = companies.append((name, base_url ~ "/" ~ path, count)) %}{% endfor %}
    {{ rows(companies) }}
    {% endif %}
  </div>
  </main>
  {% include "_footer.html.jinja" %}
</body>
</html>
