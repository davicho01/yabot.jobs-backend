{# Shared <style> block for the generated SEO pages: a copy of
   yabot.jobs-frontend's card style (src/index.css tokens, the glass header in
   src/components/Header.css, the board's band cards in
   src/pages/JobBoardCards.css), so these pages read as the same product
   without depending on the SPA's build pipeline. Only prefers-color-scheme
   is honored (not the app's manual light/dark toggle, which needs
   JS/localStorage), which is fine for a page mostly landed on fresh from
   search. #}
<style>
  :root {
    --page: #f6f6f7;
    --surface: #ffffff;
    --chip: #f0f0f3;
    --ink: #0a0a0a;
    --ink-soft: #5d5d66;
    --line: #e7e7ea;
    --focus: #d1007c;
    --lime: #cdea8f;
    --pay-ink: #3f6212;
    --sunset: linear-gradient(227deg, #ec008c 3%, #fc8b67 69%, #ffd46d 98%);
    --btn-run: linear-gradient(110deg, #7c3aed, #2563eb);
    --plum-band:
      radial-gradient(45% 80% at 10% 0%, rgba(236, 0, 140, 0.5), transparent 70%),
      radial-gradient(40% 70% at 95% 110%, rgba(124, 58, 237, 0.75), transparent 70%),
      radial-gradient(30% 50% at 60% 40%, rgba(222, 88, 138, 0.22), transparent 70%),
      #1f1a35;
    --washes:
      radial-gradient(40% 420px at 12% 0%, rgba(236, 0, 140, 0.26), transparent 70%),
      radial-gradient(34% 380px at 55% 0%, rgba(252, 139, 103, 0.28), transparent 70%),
      radial-gradient(38% 420px at 92% 0%, rgba(54, 78, 169, 0.24), transparent 70%);
    --glass-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.06));
    --glass-edge: rgba(255, 255, 255, 0.6);
    --glass-chip: rgba(255, 255, 255, 0.22);
    --glass-ring: rgba(10, 10, 10, 0.14);
    --glass-shadow: 0 10px 40px rgba(31, 26, 53, 0.12), 0 1px 3px rgba(31, 26, 53, 0.06);
    --shadow-card: 0 12px 28px rgba(31, 26, 53, 0.09), 0 2px 5px rgba(31, 26, 53, 0.05);
    /* The card lists' violet-to-green run (src/utils/listGradient.ts) at
       the five points a list walks through. */
    --run-0: #7c3aed;
    --run-1: color-mix(in oklch, #7c3aed, #2563eb 75%);
    --run-2: color-mix(in oklch, #2563eb, #0d9488 50%);
    --run-3: color-mix(in oklch, #0d9488, #16a34a 25%);
    --run-4: #16a34a;
    --font: "Inter", system-ui, -apple-system, sans-serif;
    --wrap: 1200px;
    --read: 760px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #0a0a0c;
      --surface: #1c1b22;
      --chip: #2a2931;
      --ink: #f5f5f7;
      --ink-soft: #9a99a6;
      --line: #2c2c33;
      --focus: #ff4fae;
      --pay-ink: var(--lime);
      --washes:
        radial-gradient(40% 420px at 12% 0%, rgba(236, 0, 140, 0.22), transparent 70%),
        radial-gradient(34% 380px at 55% 0%, rgba(252, 139, 103, 0.14), transparent 70%),
        radial-gradient(38% 420px at 92% 0%, rgba(54, 78, 169, 0.3), transparent 70%);
      --glass-bg: linear-gradient(180deg, rgba(60, 58, 72, 0.38), rgba(20, 19, 26, 0.18));
      --glass-edge: rgba(255, 255, 255, 0.12);
      --glass-chip: rgba(255, 255, 255, 0.06);
      --glass-ring: rgba(255, 255, 255, 0.2);
      --glass-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
      --shadow-card: 0 0 0 1px #2c2c33;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--washes), var(--page);
    background-repeat: no-repeat;
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.55;
    overflow-wrap: break-word;
  }
  h1, h2, h3 { font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; text-wrap: balance; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 0 0 0.6rem; }
  h2 { font-size: 1.3rem; margin: 2.5rem 0 1rem; }
  p, li { text-wrap: pretty; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
  /* A page that's one column (a sector's days): the whole page centered at
     reading width rather than spread to the header's edges. */
  .wrap--narrow { max-width: calc(var(--read) + 2.5rem); }
  /* The "no longer available" pages have no breadcrumb above the title. */
  .wrap--gone { padding-top: 3rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .skip { position: absolute; left: -9999px; top: 0; background: var(--surface); color: var(--ink); padding: 0.75rem 1rem; z-index: 10; border-radius: 12px; }
  .skip:focus { left: 1rem; top: 1rem; }

  /* ---------- buttons: pills ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem;
    min-height: 2.6rem; padding: 0.6rem 1.2rem; border: 0; border-radius: 999px;
    font: 600 0.9rem/1.1 var(--font); text-decoration: none; white-space: nowrap; cursor: pointer;
  }
  .btn--run { background: var(--btn-run); color: #fff; box-shadow: 0 8px 20px -8px rgba(109, 59, 230, 0.5); }
  .btn--sunset { background: var(--sunset); color: #fff; box-shadow: 0 8px 20px -8px rgba(236, 0, 140, 0.5); }
  .btn--run:hover, .btn--sunset:hover { filter: brightness(1.06); }
  .btn--chip { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-card); }
  .btn--chip:hover { color: var(--focus); }

  /* ---------- the glass header (Header.css's .site-header--glass) ---------- */
  .top { padding: 10px 12px 0; }
  .top__row {
    max-width: var(--wrap); margin: 0 auto; display: flex; align-items: center; gap: 0.75rem;
    padding: 0.55rem 0.6rem 0.55rem 1rem; border-radius: 28px;
    background: var(--glass-bg); border: 1px solid var(--glass-edge);
    -webkit-backdrop-filter: blur(14px) saturate(200%); backdrop-filter: blur(14px) saturate(200%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), var(--glass-shadow);
  }
  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem; flex-shrink: 0; color: var(--ink); text-decoration: none;
    font-family: "Outfit", var(--font); font-weight: 800; font-size: 1.2rem; letter-spacing: -0.03em;
  }
  .brand__mark { display: inline-flex; width: 2rem; height: 2rem; align-items: center; justify-content: center; background: var(--sunset); color: #fff; border-radius: 10px; }
  .search {
    flex: 1 1 20rem; min-width: 0; max-width: 40rem; margin-inline: auto;
    display: grid; grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr) auto; align-items: center;
    background: var(--glass-chip); border: 1px solid var(--glass-edge); border-radius: 999px;
    padding: 0.2rem 0.2rem 0.2rem 1.1rem;
  }
  .search:focus-within { border-color: var(--focus); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 18%, transparent); }
  .search input { min-width: 0; width: 100%; border: 0; outline: 0; background: transparent; padding: 0.55rem 0.75rem 0.55rem 0; color: var(--ink); font: 0.92rem var(--font); }
  .search input::placeholder { color: var(--ink-soft); opacity: 1; }
  .search__rule { width: 1px; height: 1.4rem; background: var(--line); }
  .search .search__rule + label + input { padding-left: 0.9rem; }
  .search .btn { min-height: 2.3rem; padding: 0.45rem 1.1rem; }
  .top__actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  /* Log in: Header.css's .site-header__login on the glass header, a clear
     chip that fills with the blue-violet run on hover. */
  .top__login {
    font: 600 0.88rem/1.55 var(--font); color: var(--ink); text-decoration: none; white-space: nowrap;
    padding: 0.55rem 1.1rem; border: 1px solid transparent; border-radius: 980px; background: var(--glass-chip);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .top__login:hover { background: var(--btn-run); color: #fff; }
  .top__search-icon { display: none; }
  @media (max-width: 760px) {
    .top { padding: 8px 8px 0; }
    .search { display: none; }
    .top__actions { margin-left: auto; gap: 0; }
    /* The app's phone search button (Header.css's .site-header__search-toggle). */
    .top__search-icon {
      display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center;
      border-radius: 50%; border: 1px solid var(--glass-ring); color: var(--ink-soft);
    }
  }

  /* ---------- the page's head: crumbs, title, intro ---------- */
  nav.breadcrumb { display: flex; flex-wrap: wrap; gap: 0.25rem 0.4rem; align-items: center; font-size: 0.85rem; color: var(--ink-soft); margin: 0.5rem 0 1.25rem; }
  nav.breadcrumb a { color: var(--ink-soft); text-decoration: none; }
  nav.breadcrumb a:hover { color: var(--focus); }
  nav.breadcrumb span[aria-current] { color: var(--ink); font-weight: 600; }
  .lede { color: var(--ink-soft); font-size: 1.05rem; max-width: var(--read); margin: 0 0 1rem; }
  .meta-line { color: var(--ink-soft); font-size: 0.95rem; margin: 0.25rem 0 1rem; }
  .notice { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0.75rem 0 1.25rem; padding: 0.35rem 0.8rem; border-radius: 16px; background: var(--surface); box-shadow: var(--shadow-card); font-size: 0.8rem; color: var(--ink-soft); }
  .notice i { flex: none; width: 8px; height: 8px; border-radius: 50%; background: #16a34a; box-shadow: 0 0 0 3px color-mix(in srgb, #16a34a 22%, transparent); }
  .notice + h2 { margin-top: 1rem; }
  .head-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 0.5rem; }
  /* A long label ("Browse current … jobs in United States") wraps rather than running off a phone. */
  .head-actions .btn { white-space: normal; text-align: center; max-width: 100%; }
  .count { color: var(--ink-soft); font-weight: 500; }

  /* ---------- chips: link lists, other sectors ---------- */
  ul.chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  ul.chips li > * { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.9rem; border-radius: 999px; background: var(--surface); box-shadow: var(--shadow-card); font-size: 0.88rem; font-weight: 600; text-decoration: none; color: var(--ink); }
  ul.chips li > span { background: var(--chip); box-shadow: none; font-weight: 500; }
  ul.chips a:hover { color: var(--focus); }

  /* ---------- tiles: sectors, days, top locations/companies ---------- */
  ul.tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem; }
  ul.tiles a { display: flex; flex-direction: column; gap: 0.15rem; height: 100%; padding: 1rem 1.1rem; border-radius: 22px; background: var(--surface); box-shadow: var(--shadow-card); text-decoration: none; color: var(--ink); transition: transform 0.15s ease; }
  ul.tiles a:hover { transform: translateY(-2px); }
  ul.tiles strong { font-weight: 600; letter-spacing: -0.01em; }
  ul.tiles .count { font-size: 0.85rem; }
  @media (hover: none) { ul.tiles a:hover { transform: none; } }

  /* ---------- day rows: a sector's days, one card per month ---------- */
  ul.day-rows { list-style: none; margin: 0; padding: 0.35rem 0; max-width: var(--read); border-radius: 26px; background: var(--surface); box-shadow: var(--shadow-card); }
  ul.day-rows li + li { border-top: 1px solid var(--line); margin-inline: 1.1rem; }
  ul.day-rows li + li a { padding-inline: 0; }
  ul.day-rows a { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) 6.5rem; align-items: center; gap: 1rem; padding: 0.7rem 1.1rem; text-decoration: none; color: var(--ink); }
  ul.day-rows strong { font-weight: 600; }
  ul.day-rows a:hover strong { color: var(--focus); }
  ul.day-rows .count { text-align: right; font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  /* Named rows (sectors, places, companies) need a wider first column. */
  ul.day-rows--named a { grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) 7rem; }
  ul.day-rows--named strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .day-rows__bar { height: 8px; border-radius: 999px; background: var(--chip); overflow: hidden; }
  .day-rows__bar i { display: block; height: 100%; min-width: 8px; border-radius: inherit; background: var(--btn-run); }
  @media (max-width: 760px) {
    ul.day-rows a { grid-template-columns: 6.5rem minmax(0, 1fr) 5.5rem; gap: 0.75rem; padding: 0.7rem 1rem; }
    ul.day-rows li + li { margin-inline: 1rem; }
    ul.day-rows--named a { grid-template-columns: minmax(0, 1fr) 4.5rem 5.5rem; }
  }

  /* ---------- band cards (the board's .band-card) ---------- */
  ul.job-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
  ul.job-list li {
    --c: var(--run-0); --c-end: var(--run-1);
    position: relative; display: flex; flex-direction: column; min-width: 0;
    background: linear-gradient(110deg, var(--c), var(--c-end)) top / 100% 35px no-repeat, var(--surface);
    border-radius: 26px; box-shadow: var(--shadow-card); overflow: hidden;
    transition: transform 0.15s ease;
  }
  ul.job-list li:nth-child(8n+2) { --c: var(--run-1); --c-end: var(--run-2); }
  ul.job-list li:nth-child(8n+3) { --c: var(--run-2); --c-end: var(--run-3); }
  ul.job-list li:nth-child(8n+4) { --c: var(--run-3); --c-end: var(--run-4); }
  ul.job-list li:nth-child(8n+5) { --c: var(--run-4); --c-end: var(--run-3); }
  ul.job-list li:nth-child(8n+6) { --c: var(--run-3); --c-end: var(--run-2); }
  ul.job-list li:nth-child(8n+7) { --c: var(--run-2); --c-end: var(--run-1); }
  ul.job-list li:nth-child(8n+8) { --c: var(--run-1); --c-end: var(--run-0); }
  ul.job-list li:hover { transform: translateY(-2px); }
  ul.job-list li:focus-within { box-shadow: 0 0 0 2px var(--c), var(--shadow-card); }
  @media (hover: none) { ul.job-list li:hover { transform: none; } }
  .job-tile { position: absolute; left: 16px; top: 14px; width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: #fff; box-shadow: 0 4px 14px rgba(31, 26, 53, 0.16); overflow: hidden; }
  .job-tile img { width: 32px; height: 32px; object-fit: contain; border-radius: 8px; }
  .job-body { display: flex; flex-direction: column; gap: 0.15rem; flex: 1; padding: 4.25rem 1rem 1rem; min-width: 0; }
  .job-company { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .job-title { font-size: 1.1rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.2; }
  .job-title a { text-decoration: none; color: var(--ink); }
  /* The whole card is the title's link. */
  .job-title a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .job-title a:focus-visible { outline: 0; }
  .job-meta { font-size: 0.88rem; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .job-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-top: auto; padding-top: 0.6rem; }
  .job-pay { padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.9rem; font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--pay-ink); background: color-mix(in srgb, var(--lime) 45%, transparent); }
  .job-posted { margin-left: auto; font-size: 0.72rem; color: var(--ink-soft); }
  @media (prefers-color-scheme: dark) { .job-pay { background: color-mix(in srgb, var(--lime) 16%, transparent); } }

  /* ---------- compact rows on one card (the day pages' long lists) ---------- */
  ul.job-rows { list-style: none; margin: 0; padding: 0.4rem 0; border-radius: 26px; background: var(--surface); box-shadow: var(--shadow-card); }
  ul.job-rows li { position: relative; display: flex; align-items: center; gap: 0.85rem; padding: 0.7rem 1.1rem; }
  ul.job-rows li + li::before { content: ""; position: absolute; top: 0; left: calc(1.1rem + 40px + 0.85rem); right: 1.1rem; border-top: 1px solid var(--line); }
  ul.job-rows li:hover { background: color-mix(in srgb, var(--chip) 60%, transparent); }
  .job-rows__logo { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: #fff; box-shadow: 0 2px 8px rgba(31, 26, 53, 0.12); overflow: hidden; }
  /* No logo yet: the company's initial, as the app's letter avatar. */
  .job-rows__logo b { font-weight: 700; color: #1f1a35; }
  .job-rows__logo img { width: 28px; height: 28px; object-fit: contain; border-radius: 6px; }
  .job-rows__body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .job-rows__title { font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; text-decoration: none; color: var(--ink); }
  /* The whole row is the title's link. */
  .job-rows__title::after { content: ""; position: absolute; inset: 0; }
  .job-rows__meta { font-size: 0.85rem; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  ul.job-rows .job-pay { flex: none; font-size: 0.82rem; }
  ul.job-rows .job-pay:empty { display: none; }
  .job-rows__company + .job-rows__place::before { content: " · "; }
  .job-rows__when { flex: none; font-size: 0.78rem; color: var(--ink-soft); white-space: nowrap; }
  /* The hubs' lists (job-rows--stacked) keep the phone's two-line rows on a
     desktop too: title over place, the posting day at the right. */
  /* One company's own page: no logo column. */
  ul.job-rows--one-company li + li::before { left: 1.1rem; }
  @media (max-width: 760px) {
    ul.job-rows li { flex-wrap: wrap; align-items: flex-start; padding: 0.7rem 0.9rem; gap: 0 0.75rem; }
    ul.job-rows li + li::before { left: 0.9rem; right: 0.9rem; }
    .job-rows__body { flex-basis: calc(100% - 40px - 0.75rem); }
    ul.job-rows .job-pay { margin-left: calc(40px + 0.75rem); margin-top: 0.3rem; }
    /* A row with a posting date (the hubs' lists): the date at the end of
       the place line rather than on a line of its own. */
    ul.job-rows li:has(.job-rows__when) { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: baseline; }
    ul.job-rows li:has(.job-rows__when) .job-rows__logo { grid-row: span 2; align-self: start; }
    ul.job-rows li:has(.job-rows__when) .job-rows__body { display: contents; }
    ul.job-rows li:has(.job-rows__when) .job-rows__title { grid-column: 2 / -1; }
    ul.job-rows--one-company li:has(.job-rows__when) { grid-template-columns: minmax(0, 1fr) auto; }
    ul.job-rows--one-company li:has(.job-rows__when) .job-rows__title { grid-column: 1 / -1; }
    ul.job-rows--one-company li + li::before { left: 0.9rem; }
  }

  /* On a desktop the day's list is a plain table-like list: one line per
     job in fixed columns (logo, title, "company · place", pay), so each
     column lines up down the page; a long value is cut off with an ellipsis. */
  @media (min-width: 761px) {
    ul.job-rows:not(.job-rows--stacked) { padding: 0; border-radius: 0; background: none; box-shadow: none; border-top: 1px solid var(--line); }
    ul.job-rows:not(.job-rows--stacked) li {
      display: grid; grid-template-columns: 28px minmax(0, 1.1fr) minmax(0, 1fr) 9.5rem;
      align-items: center; gap: 0.9rem; padding: 0.5rem 0.25rem; border-bottom: 1px solid var(--line);
    }
    ul.job-rows:not(.job-rows--stacked) li + li::before { display: none; }
    ul.job-rows:not(.job-rows--stacked) li:hover { background: none; }
    ul.job-rows:not(.job-rows--stacked) li:hover .job-rows__title { color: var(--focus); }
    ul.job-rows:not(.job-rows--stacked) .job-rows__logo { width: 28px; height: 28px; border-radius: 8px; box-shadow: 0 0 0 1px var(--line); }
    ul.job-rows:not(.job-rows--stacked) .job-rows__logo img { width: 20px; height: 20px; border-radius: 4px; }
    ul.job-rows:not(.job-rows--stacked) .job-rows__logo b { font-size: 0.8rem; }
    ul.job-rows:not(.job-rows--stacked) .job-rows__body { display: contents; }
    ul.job-rows:not(.job-rows--stacked) .job-rows__title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    ul.job-rows:not(.job-rows--stacked) .job-pay, ul.job-rows:not(.job-rows--stacked) .job-pay:empty { display: block; grid-column: 4; padding: 0; background: none; font-size: 0.85rem; text-align: right; }
    ul.job-rows:not(.job-rows--stacked) .job-rows__when { grid-column: 4; text-align: right; }
    ul.job-rows--one-company:not(.job-rows--stacked) li { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) 9.5rem; }
    ul.job-rows--one-company:not(.job-rows--stacked) .job-rows__when { grid-column: 3; }
  }

  /* ---------- prev/next, "more" links ---------- */
  .pager { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-top: 2rem; }
  .more-link { margin: 1rem 0 0; }
  .more-link a { font-weight: 600; text-decoration: none; color: var(--ink); }
  .more-link a:hover { color: var(--focus); }

  /* ---------- the footer ---------- */
  .site-credits { max-width: var(--wrap); margin: 0 auto; padding: 1.5rem 1.25rem 2rem; border-top: 1px solid var(--line); font-size: 0.8rem; color: var(--ink-soft); display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .site-credits p { margin: 0; }
