{# The app's glass header: brand mark, a real (no-JS) GET /jobs search form,
   and a log-in link, so a generated page reads as part of the site, not an
   orphan, and gives crawlers/users a real path back into the live board. On
   a phone the search form gives way to a search button that opens the
   board, as the app's header does. #}
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="top__row">
    <a class="brand" href="{{ base_url }}/" aria-label="Yabot Jobs home">
      {% include "_brand_mark.html.jinja" %}
      Yabot Jobs
    </a>
    <form class="search" role="search" action="{{ base_url }}/jobs" method="get">
      <label class="sr" for="search-q">Job title or keyword</label>
      <input id="search-q" name="q" type="search" placeholder="Search postings by title…" autocomplete="off" enterkeyhint="search" />
      <span class="search__rule" aria-hidden="true"></span>
      <label class="sr" for="search-location">City or state</label>
      <input id="search-location" name="location" type="search" placeholder="City or state…" autocomplete="off" enterkeyhint="search" />
      <button class="btn btn--run" type="submit">Search</button>
    </form>
    <nav class="top__actions" aria-label="Account">
      <a class="top__search-icon" href="{{ base_url }}/jobs" aria-label="Search jobs">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
      <a class="btn top__login" href="{{ base_url }}/login">Log in</a>
    </nav>
  </div>
</header>
