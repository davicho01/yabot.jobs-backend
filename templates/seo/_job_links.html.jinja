{# A list of links to other job pages (static_job_pages.LinkJob), each at its own stored path. #}
<ul class="job-list">
  {% for j in jobs %}
  <li>
    <div class="job-title"><a href="{{ base_url }}/{{ j.path }}" data-track="{{ track | default('job') }}">{{ j.title }}</a></div>
    <div class="job-meta">{{ j.company_display }}{% if j.location %} &middot; {{ j.location }}{% endif %} &middot; Posted {{ j.day.strftime('%b %-d, %Y') }}</div>
  </li>
  {% endfor %}
</ul>
