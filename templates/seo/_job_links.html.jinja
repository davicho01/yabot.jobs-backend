{# Links to other job pages (static_job_pages.LinkJob), each at its own
   stored path, as the board's band cards: the logo tile on a color band,
   the company, the title (the whole card is its link), the place and the
   posting day. #}
<ul class="job-list">
  {% for j in jobs %}
  <li>
    <span class="job-tile">{% if j.logo_url %}<img src="{{ j.logo_url }}" alt="" width="32" height="32" loading="lazy" />{% endif %}</span>
    <div class="job-body">
      <div class="job-company">{{ j.company_display }}</div>
      <div class="job-title"><a href="{{ base_url }}/{{ j.path }}" data-track="{{ track | default('job') }}">{{ j.title }}</a></div>
      {% if j.location %}<div class="job-meta">{{ j.location }}</div>{% endif %}
      <div class="job-tags"><span class="job-posted">Posted {{ j.day.strftime('%b %-d') }}</span></div>
    </div>
  </li>
  {% endfor %}
</ul>
