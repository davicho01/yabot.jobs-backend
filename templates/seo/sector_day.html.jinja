<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ sector_name }} Jobs in {{ country_name }}, Posted {{ date_display }} | Yabot Jobs</title>
  <meta name="description" content="{{ job_count }} {{ sector_name }} job{{ '' if job_count == 1 else 's' }} posted in {{ country_name }} on {{ date_display }}, updated throughout the day. Free to search and apply on Yabot Jobs." />
  <link rel="canonical" href="{{ base_url }}/jobs/{{ country_slug }}/{{ sector_slug }}/{{ date_iso }}" />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Yabot Jobs" />
  <meta property="og:title" content="{{ sector_name }} Jobs in {{ country_name }}, Posted {{ date_display }}" />
  <meta property="og:description" content="{{ job_count }} {{ sector_name }} job{{ '' if job_count == 1 else 's' }} posted in {{ country_name }} on {{ date_display }}." />
  <meta property="og:url" content="{{ base_url }}/jobs/{{ country_slug }}/{{ sector_slug }}/{{ date_iso }}" />
  {% include "_fonts.html.jinja" %}
  {% include "_base_style.html.jinja" %}
  {% with page_type = "day" %}{% include "_analytics.html.jinja" %}{% endwith %}
  <script type="application/ld+json">{{ job_ld_json|safe }}</script>
</head>
<body>
  {% include "_header.html.jinja" %}
  <main id="main">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ base_url }}/">Home</a> &rsaquo;
      <a href="{{ base_url }}/jobs">Jobs</a> &rsaquo;
      <a href="{{ base_url }}/jobs/{{ country_slug }}">{{ country_name }}</a> &rsaquo;
      <a href="{{ base_url }}/jobs/{{ country_slug }}/{{ sector_slug }}">{{ sector_name }}</a> &rsaquo;
      <span aria-current="page">{{ date_display }}</span>
    </nav>
    <h1>{{ sector_name }} Jobs in {{ country_name }}, Posted {{ date_display }}</h1>
    <p class="meta-line">{{ job_count }} job{{ '' if job_count == 1 else 's' }} found &middot; Updated as of {{ generated_at_display }} Pacific</p>
    {% include "_scan_notice.html.jinja" %}

    {# A day can list a thousand jobs or more, so they're compact rows on
       one card rather than a band card each (which ran a phone to ~350
       screens). Every job stays on the page, so crawlers reach them all. #}
    <ul class="job-rows">
    {% for job in jobs %}
      <li>
        <span class="job-rows__logo">{% if job.company_logo_url %}<img src="{{ job.company_logo_url }}" alt="" width="28" height="28" loading="lazy" />{% else %}<b>{{ (job.company_name or "?")[:1] | upper }}</b>{% endif %}</span>
        <div class="job-rows__body">
          <a class="job-rows__title" href="{{ base_url }}/{{ job.href_path }}" data-track="day_job">{{ job.title }}</a>
          <span class="job-rows__meta"><span class="job-rows__company">{{ job.company_name or "Unknown company" }}</span>{% if job.location %}<span class="job-rows__place">{{ job.location }}</span>{% endif %}</span>
        </div>
        <span class="job-pay">{{ job.salary_display or "" }}</span>
      </li>
    {% endfor %}
    </ul>

    <nav class="pager" aria-label="Other days">
      <span>{% if prev_day %}<a class="btn btn--chip" href="{{ base_url }}/jobs/{{ country_slug }}/{{ sector_slug }}/{{ prev_day }}">&lsaquo; Previous day</a>{% endif %}</span>
      <span>{% if next_day %}<a class="btn btn--run" href="{{ base_url }}/jobs/{{ country_slug }}/{{ sector_slug }}/{{ next_day }}">Next day &rsaquo;</a>{% endif %}</span>
    </nav>
    <p class="more-link"><a href="{{ base_url }}/jobs/{{ country_slug }}/{{ sector_slug }}">Browse all {{ sector_name }} days &rarr;</a></p>

    <section aria-labelledby="other-h">
      <h2 id="other-h">Other sectors</h2>
      <ul class="chips">
        {% for name, slug in other_sectors %}<li><a href="{{ base_url }}/jobs/{{ country_slug }}/{{ slug }}">{{ name }}</a></li>{% endfor %}
      </ul>
    </section>
  </div>
  </main>
  {% include "_footer.html.jinja" %}
</body>
</html>
