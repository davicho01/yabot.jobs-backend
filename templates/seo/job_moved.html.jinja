<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {#- What a legacy /job/{url_id} page becomes once its job has moved to its
      descriptive /jobs/us/... path — see static_job_pages. The canonical and
      the instant refresh are what Google reads as a permanent redirect (S3
      can't send a 301 here), so the old URL's standing passes to the new
      one; not noindex, which would drop it instead. -#}
  <title>{{ title }} | Yabot Jobs</title>
  <link rel="canonical" href="{{ new_url }}" />
  <meta http-equiv="refresh" content="0; url={{ new_url }}" />
  {% include "_fonts.html.jinja" %}
  {% include "_icons.html.jinja" %}
  {% include "_base_style.html.jinja" %}
  {% with page_type = "job_moved" %}{% include "_analytics.html.jinja" %}{% endwith %}
</head>
<body>
  {% include "_header.html.jinja" %}
  <main id="main">
  <div class="wrap wrap--narrow wrap--gone">
    <h1>This job has moved</h1>
    <p class="lede"><a href="{{ new_url }}">{{ title }}</a></p>
  </div>
  </main>
  {% include "_footer.html.jinja" %}
</body>
</html>
