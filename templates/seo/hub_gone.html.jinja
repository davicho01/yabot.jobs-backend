<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {#- A company/location hub that no longer has enough live jobs (see
      static_hub_pages): out of search, with links onward. -#}
  <title>No Current Jobs | Yabot Jobs</title>
  <meta name="robots" content="noindex, follow" />
  <meta name="description" content="There aren't enough open jobs on this page right now. Browse current jobs in the United States on Yabot Jobs." />
  {% include "_fonts.html.jinja" %}
  {% include "_icons.html.jinja" %}
  {% include "_base_style.html.jinja" %}
  {% with page_type = "hub_gone" %}{% include "_analytics.html.jinja" %}{% endwith %}
</head>
<body>
  {% include "_header.html.jinja" %}
  <main id="main">
  <div class="wrap wrap--narrow wrap--gone">
    <h1>No current jobs here</h1>
    <p class="lede">There aren't enough open jobs on this page right now.</p>
    <div class="head-actions">
      <a class="btn btn--chip" href="{{ base_url }}/jobs/{{ country_slug }}" data-track="browse_country">Browse jobs in the United States</a>
      <a class="btn btn--run" href="{{ base_url }}/jobs" data-track="search_all">Search all jobs</a>
    </div>
  </div>
  </main>
  {% include "_footer.html.jinja" %}
</body>
</html>
